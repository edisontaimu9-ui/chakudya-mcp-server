# ── Chakudya Nutrition Registry API (the Worker you already have deployed) ──
CHAKUDYA_API_BASE_URL=https://chakudya-api.edisontaimu9.workers.dev

# Only needed if you later want the MCP server to be able to call admin-gated
# CNR routes (none of the 15 tools below need this today — all of them hit
# public GET or public rate-limited POST routes on the CNR API).
# CHAKUDYA_ADMIN_API_KEY=

# ── MCP server's own HTTP surface ──
PORT=8787

# Bearer token clients must send as `Authorization: Bearer <token>` to reach
# this MCP server. Required in production. Leave unset only for local dev.
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Comma-separated list of allowed CORS origins for browser-based MCP clients.
# Leave blank to disable browser access entirely (recommended unless you have
# a specific web-based MCP client).
MCP_ALLOWED_ORIGINS=

# Max requests per IP per minute against the MCP endpoint itself, independent
# of whatever rate limiting the CNR API already does.
MCP_RATE_LIMIT_PER_MIN=60

# "development" enables verbose logging; "production" trims it down.
NODE_ENV=development
